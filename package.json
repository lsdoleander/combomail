{
  "name": "combomail",
  "version": "0.3.1",
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "bun": "^1.2.15",
    "rollup": "^4.42.0"
  },
  "dependencies": {
    "@rollup/plugin-alias": "^5.1.1",
    "async": "^3.2.6",
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.0.0",
    "commander": "^14.0.1",
    "cors": "^2.8.5",
    "domainiac": "https://github.com/paulwardrip/domainiac.git",
    "express": "^5.1.0",
    "express-ws": "^5.0.2",
    "fetching": "https://github.com/lsdoleander/fetching.git",
    "find-process": "^2.0.0",
    "imap": "^0.8.19",
    "imapflow": "^1.0.191",
    "json5": "^2.2.3",
    "konsole": "https://github.com/lsdoleander/konsole.git",
    "mailblazer": "https://github.com/paulwardrip/mailblazer.git",
    "mailparser": "^3.7.4",
    "ps-node": "^0.1.6",
    "uuid": "^11.0.2"
  },
  "scripts": {
    "update": "git pull && bun install && bun run update-konsole && bun run update-fetching",
    "update-domainiac": "bun add https://github.com/paulwardrip/domainiac.git",
    "update-fetching": "bun add https://github.com/lsdoleander/fetching.git",
    "update-konsole": "bun add https://github.com/lsdoleander/konsole.git",
    "update-mailblazer": "bun add https://github.com/paulwardrip/mailblazer.git",
    "clear": "bun src/datareset.js && rm -rf ~/.local/share/combomail/logs/*",
    "clean": "bun src/build.js",
    "build": "bun run clean && bun run update && bun run static && bun run rollup && bun run dist",
    "static": "bun src/statictool.js gen/www.js src/ui/www/",
    "rollup": "bun x rollup -c",
    "dist": "bun run win && bun run linux && bun run zip && bun run tar",
    "win": "bun build --compile --target=bun-windows-x64 ./gen/bundle.min.js --outfile gen/win/combomail.exe",
    "linux": "bun build --compile --target=bun-linux-x64 ./gen/bundle.min.js --outfile gen/linux/combomail",
    "zip": "cd gen/win && zip -7 ../../dist/combomail-windows-x64.zip combomail.exe",
    "tar": "cd gen/linux && tar cvf ../../dist/combomail-linux-x64.tar.xz -I 'xz -7 -T2' combomail"
  }
}
